<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_ugv_mission</name>
  <version>0.1.0</version>
  <description>Public-safe ROS 2/PX4 mission-integration staging package for a UAV–UGV cooperative mission.</description>
  <maintainer email="release-review-required@example.invalid">Public release staging</maintainer>
  <license>LicenseRef-Pending-Review</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
